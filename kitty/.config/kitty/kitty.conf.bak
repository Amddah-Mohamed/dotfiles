##########################################################################

# terminal opacity and blur
background_opacity 0.8
background_blur 8

# advance 
term xterm-kitty

# terminal bell
enable_audio_bell no

# os specific tweaks (Gnome window decoration for wayland)
linux_display_server wayland

# Typography
# font_family Iosevka
# bold_font auto
# italic_font auto
# bold_italic_font auto
font_size 14.0

disable_ligatures never

modify_font cell_width 100%
modify_font cell_height 110%


cursor_beam_thickness 4

# Window appearance
window_padding_width 20
window_margin_width 2
window_border_width 1.5pt

# font size management 
map ctrl+shift+backspace change_font_size all 0

# cursor customization
# block / beam / underline
cursor_shape beam
cursor_blink_interval 0.5
cursor_stop_blinking_after 0
shell_integration no-cursor

# scrollback
scrollback_lines 5000
wheel_scroll_multiplier 3.0

# mouse
mouse_hide_wait -1

# window layout
remember_window_size  no
initial_window_width  1200
initial_window_height 750
window_border_width 1.5pt
enabled_layouts tall,stack,grid,splits
window_padding_width 0
window_margin_width 2
hide_window_decorations no

# window management 
map ctrl+shift+enter new_window
map ctrl+shift+] next_window
map ctrl+shift+[ previous_window

# layout management
map ctrl+shift+l next_layout
map ctrl+alt+r goto_layout tall
map ctrl+alt+s goto_layout stack

# tab bar customization
tab_bar_style powerline
tab_powerline_style slanted
tab_bar_edge bottom
tab_bar_align left
active_tab_font_style   bold
inactive_tab_font_style normal

# tab management
map ctrl+shift+t new_tab
map ctrl+shift+right next_tab
map ctrl+shift+left previous_tab
map ctrl+shift+q close_tab

#URLs and hyperlinks 
detect_urls yes
# url_color #ffff00
url_style curly
open_url_with default
map ctrl+shift+e open_url_with_hints





# BEGIN_KITTY_THEME
# Base4Tone_Classic_D Dark
include current-theme.conf
# END_KITTY_THEME


# BEGIN_KITTY_FONTS
font_family      family="Iosevka Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS